# Base de données PostgreSQL
DATABASE_URL="postgresql://salim@localhost:5432/whiteboard"

# Authentification (Better Auth)
BETTER_AUTH_SECRET="votre_secret_de_session_better_auth_min_32_caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# URLs des applications
APP_URL="http://localhost:3000"
SYNC_URL="ws://localhost:1234"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SYNC_URL="ws://localhost:1234"

# Stockage MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="whiteboard-assets"
S3_FORCE_PATH_STYLE="true"

# Intelligence Artificielle (Anthropic Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Transcription vocale (OpenAI Whisper)
OPENAI_API_KEY=""

# Mode de stockage local de secours (utilisé si MinIO n'est pas déployé localement)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
